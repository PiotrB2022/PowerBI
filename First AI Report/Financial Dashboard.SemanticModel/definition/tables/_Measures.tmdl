	/// SVG KPI card (value, 12-month sparkline, MoM and vs monthly average) for Net Margin %.
	measure 'Net Margin % SVG Card' =
			VAR _val = [Net Margin %]
			VAR _end = CALCULATE(MAX('Date'[Date]), Transactions)
			VAR _months =
				ADDCOLUMNS(
					CALCULATETABLE(VALUES('Date'[Year Month Number]), DATESINPERIOD('Date'[Date], _end, -12, MONTH)),
					"@v", VAR _ym = 'Date'[Year Month Number] RETURN CALCULATE([Net Margin %], REMOVEFILTERS('Date'), 'Date'[Year Month Number] = _ym)
				)
			VAR _t = FILTER(_months, NOT ISBLANK([@v]))
			VAR _n = COUNTROWS(_t)
			VAR _min = MINX(_t, [@v])
			VAR _max = MAXX(_t, [@v])
			VAR _rng = IF(_max = _min, 1, _max - _min)
			VAR _pts =
				ADDCOLUMNS(_t,
					"@x", ROUND(20 + (RANKX(_t, 'Date'[Year Month Number], , ASC) - 1) * 260 / MAX(_n - 1, 1), 0),
					"@y", ROUND(138 - ([@v] - _min) / _rng * 44, 0))
			VAR _line = CONCATENATEX(_pts, [@x] & "," & [@y], " ", 'Date'[Year Month Number], ASC)
			VAR _lastX = MAXX(_pts, [@x])
			VAR _lastYM = MAXX(_t, 'Date'[Year Month Number])
			VAR _prevYM = MAXX(FILTER(_t, 'Date'[Year Month Number] < _lastYM), 'Date'[Year Month Number])
			VAR _last = MAXX(FILTER(_t, 'Date'[Year Month Number] = _lastYM), [@v])
			VAR _prev = MAXX(FILTER(_t, 'Date'[Year Month Number] = _prevYM), [@v])
			VAR _avg = AVERAGEX(_t, [@v])
			VAR _d1 = IF(NOT ISBLANK(_prev), _last - _prev)
			VAR _d2 = IF(_n > 1, _last - _avg)
			VAR _valTxt = FORMAT(_val, "0.0%")
			VAR _c166 = IF(_d1 >= 0, "#1E9E4A", "#D13438")
			VAR _a166 = IF(_d1 >= 0, "<polygon points='212,165 217,156 222,165' fill='" & _c166 & "'/>", "<polygon points='212,156 217,165 222,156' fill='" & _c166 & "'/>")
			VAR _r166 = "<text x='64' y='166' font-family='Segoe UI' font-size='13' fill='#3A3A48'>MoM</text>" &
				IF(ISBLANK(_d1), "<text x='206' y='166' text-anchor='end' font-family='Segoe UI' font-size='13' fill='#9AA0A6'>n/a</text>",
					"<text x='206' y='166' text-anchor='end' font-family='Segoe UI' font-size='13' font-weight='600' fill='" & _c166 & "'>" & FORMAT(ABS(_d1) * 100, "0.0") & " pp" & "</text>" & _a166)
			VAR _c188 = IF(_d2 >= 0, "#1E9E4A", "#D13438")
			VAR _a188 = IF(_d2 >= 0, "<polygon points='212,187 217,178 222,187' fill='" & _c188 & "'/>", "<polygon points='212,178 217,187 222,178' fill='" & _c188 & "'/>")
			VAR _r188 = "<text x='64' y='188' font-family='Segoe UI' font-size='13' fill='#3A3A48'>vs Avg</text>" &
				IF(ISBLANK(_d2), "<text x='206' y='188' text-anchor='end' font-family='Segoe UI' font-size='13' fill='#9AA0A6'>n/a</text>",
					"<text x='206' y='188' text-anchor='end' font-family='Segoe UI' font-size='13' font-weight='600' fill='" & _c188 & "'>" & FORMAT(ABS(_d2) * 100, "0.0") & " pp" & "</text>" & _a188)
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='300' height='200' viewBox='0 0 300 200'>" &
				"<text x='20' y='36' font-family='Segoe UI' font-size='16' font-weight='600' fill='#4A4A5A'>Net Margin %</text>" &
				"<text x='20' y='76' font-family='Segoe UI' font-size='32' font-weight='700' fill='#14141F'>" & _valTxt & "</text>" &
				IF(_n > 1,
					"<path d='M20,140 L" & _line & " L" & _lastX & ",140 Z' fill='#2F6FDB' fill-opacity='0.22'/>" &
					"<polyline points='" & _line & "' fill='none' stroke='#2F6FDB' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>") &
