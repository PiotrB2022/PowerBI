	/// SVG dumbbell: hollow grey = Expenses, filled = Revenue (blue = profit, red = loss). Scaled across rows of the same level.
	measure 'Revenue vs Expenses Dumbbell' =
			VAR _r = [Revenue]
			VAR _e = [Expenses]
			VAR _cust = FILTER(ADDCOLUMNS(ALLSELECTED(Customer), "@r", [Revenue], "@e", [Expenses]), NOT ISBLANK([@r]) && NOT ISBLANK([@e]))
			VAR _acc = FILTER(ADDCOLUMNS(ALLSELECTED(Account), "@r", [Revenue], "@e", [Expenses]), NOT ISBLANK([@r]) && NOT ISBLANK([@e]))
			VAR _lo0 =
				SWITCH(TRUE(),
					ISINSCOPE(Customer[Customer]), MINX(_cust, MIN([@r], [@e])),
					ISINSCOPE(Account[Account]), MINX(_acc, MIN([@r], [@e])),
					MIN(_r, _e) * 0.9)
			VAR _hi0 =
				SWITCH(TRUE(),
					ISINSCOPE(Customer[Customer]), MAXX(_cust, MAX([@r], [@e])),
					ISINSCOPE(Account[Account]), MAXX(_acc, MAX([@r], [@e])),
					MAX(_r, _e) * 1.1)
			VAR _pad = (_hi0 - _lo0) * 0.06 + 1
			VAR _lo = _lo0 - _pad
			VAR _rng = (_hi0 + _pad) - _lo
			VAR _xr = ROUND(12 + (_r - _lo) / _rng * 196, 0)
			VAR _xe = ROUND(12 + (_e - _lo) / _rng * 196, 0)
			VAR _col = IF(_r >= _e, "#2B6CB0", "#B4235A")
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='220' height='24' viewBox='0 0 220 24'>" &
				"<line x1='6' y1='12' x2='214' y2='12' stroke='#E4E4EA' stroke-width='2'/>" &
				"<line x1='" & _xe & "' y1='12' x2='" & _xr & "' y2='12' stroke='" & _col & "' stroke-width='3'/>" &
				"<circle cx='" & _xe & "' cy='12' r='5' fill='#FFFFFF' stroke='#9AA0A6' stroke-width='2'/>" &
				"<circle cx='" & _xr & "' cy='12' r='5.5' fill='" & _col & "'/>" &
				"</svg>"
			RETURN
				IF(NOT ISBLANK(_r) && NOT ISBLANK(_e), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23"))
		displayFolder: SVG
		dataCategory: ImageUrl
		lineageTag: 6ab82e42-6399-4c0d-9ca0-1f030e4259f0

